{
  "server": "probeowl",
  "tools": [
    {
      "annotations": {
        "destructive_hint": false,
        "open_world_hint": false,
        "read_only_hint": true
      },
      "description": "The save checks on a draft, after a scan for credentials. It writes nothing. Findings\n        name a credential's kind and line, never its value; the draft's text is not repeated.\n        environment: where plans are read, when owl mcp was started with --plan-checks.",
      "input_schema": {
        "$defs": {
          "DraftKind": {
            "description": "What a draft is: one file in a config folder.",
            "enum": [
              "entity",
              "probe",
              "connector",
              "catalog",
              "runbook"
            ],
            "title": "DraftKind",
            "type": "string"
          }
        },
        "properties": {
          "application": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Application"
          },
          "environment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Environment"
          },
          "kind": {
            "$ref": "#/$defs/DraftKind"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Name"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "text"
        ],
        "title": "check_draftArguments",
        "type": "object"
      },
      "name": "check_draft",
      "output_schema": {
        "$defs": {
          "Credential": {
            "additionalProperties": false,
            "description": "Something in the draft that looks like a secret or an address. Never any part of it.",
            "properties": {
              "line": {
                "title": "Line",
                "type": "integer"
              },
              "shown": {
                "description": "The kind and length only, such as 'password (12 characters)'.",
                "title": "Shown",
                "type": "string"
              },
              "what": {
                "enum": [
                  "password",
                  "token",
                  "connection_string",
                  "private_key",
                  "host",
                  "ip_address"
                ],
                "title": "What",
                "type": "string"
              }
            },
            "required": [
              "what",
              "line",
              "shown"
            ],
            "title": "Credential",
            "type": "object"
          },
          "DraftFinding": {
            "additionalProperties": false,
            "description": "One check's finding, in the save checks' own words.",
            "properties": {
              "check": {
                "title": "Check",
                "type": "string"
              },
              "line": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Line"
              },
              "message": {
                "title": "Message",
                "type": "string"
              },
              "severity": {
                "enum": [
                  "error",
                  "warning"
                ],
                "title": "Severity",
                "type": "string"
              }
            },
            "required": [
              "check",
              "severity",
              "message"
            ],
            "title": "DraftFinding",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "What the checks say about a draft. Its text is never repeated, here or anywhere.",
        "properties": {
          "credentials": {
            "items": {
              "$ref": "#/$defs/Credential"
            },
            "title": "Credentials",
            "type": "array"
          },
          "findings": {
            "items": {
              "$ref": "#/$defs/DraftFinding"
            },
            "title": "Findings",
            "type": "array"
          },
          "next": {
            "title": "Next",
            "type": "string"
          },
          "ok": {
            "description": "False on any error, and on any credential found.",
            "title": "Ok",
            "type": "boolean"
          },
          "paste_into": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Where to paste it, when ok.",
            "title": "Paste Into"
          }
        },
        "required": [
          "ok",
          "findings",
          "credentials",
          "paste_into",
          "next"
        ],
        "title": "DraftCheck",
        "type": "object"
      }
    },
